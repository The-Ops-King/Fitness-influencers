# ---------------------------------------------------------------------------
# Storage. Postgres or Supabase - records are re-verified and status is mutable.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://leadpipe:leadpipe@localhost:5432/leadpipe

# ---------------------------------------------------------------------------
# SERP (modules 1, 5, 6). Pick one provider; do not scrape Google directly.
# ---------------------------------------------------------------------------
SERP_PROVIDER=serper           # serper | serpapi | scraperapi
SERPER_API_KEY=
SERPAPI_KEY=
SCRAPERAPI_KEY=

# ---------------------------------------------------------------------------
# Meta Ad Library (module 2). Needs a Meta developer app plus ID verification.
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Instagram (module 3). Apify actors on residential proxies, not raw requests.
# ---------------------------------------------------------------------------
APIFY_TOKEN=
APIFY_IG_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_IG_HASHTAG_ACTOR=apify~instagram-hashtag-scraper

# ---------------------------------------------------------------------------
# YouTube (module 4)
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Email verification. Hard bounces are dropped before they touch a sender.
# ---------------------------------------------------------------------------
EMAIL_VERIFIER=none            # zerobounce | neverbounce | millionverifier | none
EMAIL_VERIFIER_KEY=

# ---------------------------------------------------------------------------
# Targeting
# ---------------------------------------------------------------------------
TARGET_COUNTRIES=US,CA,GB,AU
MIN_FOLLOWERS=1000
MAX_FOLLOWERS=150000
OUTREACH_SCORE_FLOOR=50
NURTURE_SCORE_FLOOR=30

# ---------------------------------------------------------------------------
# Rate limits and proxies, per pool. Pools are deliberately separate: never
# share a proxy pool between Instagram and SERP.
# Comma-separated, e.g. http://user:pass@host:port,http://user:pass@host2:port
# ---------------------------------------------------------------------------
SERP_RPS=2.0
SERP_CONCURRENCY=4
SERP_PROXIES=

WEB_RPS=3.0
WEB_CONCURRENCY=6
WEB_PROXIES=

META_RPS=1.0
META_CONCURRENCY=2
META_PROXIES=

# Residential pool. Instagram is the module that breaks most often.
IG_RPS=0.3
IG_CONCURRENCY=1
IG_TIMEOUT=60
IG_RETRIES=2
IG_PROXIES=

YT_RPS=2.0
YT_CONCURRENCY=3
YT_PROXIES=
