# ---------------------------------------------------------------------------
# Storage. Postgres or Supabase - records are re-verified and status is mutable.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://leadpipe:leadpipe@localhost:5432/leadpipe

# ---------------------------------------------------------------------------
# SERP (modules 1, 5, 6). Do not scrape Google directly.
#
# "auto" picks the best provider that actually has a key, falling back to
# DuckDuckGo, which needs no key at all. So this runs with zero setup and
# silently upgrades the moment you add one.
#   Free:  brave (free tier, needs a key) | duckduckgo (no key, best effort)
#   Paid:  serper | serpapi | scraperapi
# ---------------------------------------------------------------------------
SERP_PROVIDER=auto
BRAVE_API_KEY=
SERPER_API_KEY=
SERPAPI_KEY=
SCRAPERAPI_KEY=

# Hard cap on SERP calls per run, shared across modules 1, 5 and 6. This is what
# stops one sweep from eating a whole month's free allowance. 0 or blank = no cap.
SERP_MAX_CALLS_PER_RUN=2000

# ---------------------------------------------------------------------------
# Meta Ad Library (module 2). Needs a Meta developer app plus ID verification.
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Instagram (module 3) - OPTIONAL, and not part of the free path.
#
# Instagram handles are harvested for free by modules 1, 2, 4, 5 and 6 from
# booking pages, ad landing pages, YouTube About tabs and coach websites.
# Module 3 is only needed to DISCOVER coaches via Instagram and to fetch
# follower counts. Leave APIFY_TOKEN blank and module 3 skips itself cleanly;
# everything else still runs and the DM list still fills.
# ---------------------------------------------------------------------------
APIFY_TOKEN=
APIFY_IG_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_IG_HASHTAG_ACTOR=apify~instagram-hashtag-scraper

# ---------------------------------------------------------------------------
# YouTube (module 4)
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Email verification - OPTIONAL. Instagram DM is the primary channel, so this
# only matters if you also want the cold email export. Left as "none", every
# address stays unverified and cold_email.csv stays empty by design; the export
# logs how many records it held back.
# ---------------------------------------------------------------------------
EMAIL_VERIFIER=none            # zerobounce | neverbounce | millionverifier | none
EMAIL_VERIFIER_KEY=

# ---------------------------------------------------------------------------
# Targeting
# ---------------------------------------------------------------------------
TARGET_COUNTRIES=US,CA,GB,AU
# Only applied when follower data exists, i.e. when module 3 has run. Without
# it, records are neither filtered nor penalised on follower count.
MIN_FOLLOWERS=1000
MAX_FOLLOWERS=150000
OUTREACH_SCORE_FLOOR=50
NURTURE_SCORE_FLOOR=30

# ---------------------------------------------------------------------------
# Rate limits and proxies, per pool. Pools are deliberately separate: never
# share a proxy pool between Instagram and SERP.
# Comma-separated, e.g. http://user:pass@host:port,http://user:pass@host2:port
# ---------------------------------------------------------------------------
SERP_RPS=1.0                   # free tiers are ~1 query/sec
SERP_CONCURRENCY=4
SERP_PROXIES=

WEB_RPS=3.0
WEB_CONCURRENCY=6
WEB_PROXIES=

META_RPS=1.0
META_CONCURRENCY=2
META_PROXIES=

# Residential pool. Instagram is the module that breaks most often.
IG_RPS=0.3
IG_CONCURRENCY=1
IG_TIMEOUT=60
IG_RETRIES=2
IG_PROXIES=

YT_RPS=2.0
YT_CONCURRENCY=3
YT_PROXIES=
